# ==============================================================================================
# TradeMe — variables de producción (PLANTILLA)
#
# Cópiala a infra/.env.prod y rellénala. infra/.env.prod está ignorado por Git; esta plantilla NO,
# así que aquí nunca va un valor real.
#
#   PowerShell:   copy infra\.env.prod.example infra\.env.prod
#   Linux/macOS:  cp infra/.env.prod.example infra/.env.prod
#
# La lee docker-compose.prod.yml:
#   docker compose -f infra/docker-compose.prod.yml --env-file infra/.env.prod up -d --build
#
# Estas son TODAS las variables que usa ese compose. Lo demás (NODE_ENV=production,
# ENABLE_LIVE_TRADING=false, DATABASE_URL...) va fijado en el propio compose y no se toca aquí.
# ==============================================================================================

# --- Obligatorias -------------------------------------------------------------------------------
# Vacías, docker compose se niega a arrancar y dice cuál falta. Por eso no llevan valor de ejemplo.

# Contraseña de PostgreSQL. Larga y aleatoria:  openssl rand -hex 16
# Solo se aplica al crear el volumen de datos: cambiarla después no cambia la de la base.
POSTGRES_PASSWORD=

# Firma de las sesiones (JWT). Larga, aleatoria y distinta de la anterior:  openssl rand -hex 32
JWT_SECRET=

# Dirección pública de la web, sin barra final. P. ej.: https://trademe.tu-tailnet.ts.net
PUBLIC_WEB_ORIGIN=

# Dirección pública de la API. P. ej.: https://trademe.tu-tailnet.ts.net:8443
# La web se compila con ella: si la cambias, vuelve a levantar con --build.
PUBLIC_API_URL=

# --- Opcionales ---------------------------------------------------------------------------------
# Vacías, la plataforma arranca igual y esa función queda apagada.

# Web Push: notificaciones con la app cerrada. Sin las dos claves, solo avisos dentro de la app.
# No hay claves por defecto en el código. Genera un par con:  npx web-push generate-vapid-keys
# Cambiarlas invalida las suscripciones: cada dispositivo tendrá que volver a activar el push.
# Ver docs/pwa-push.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto que se envía al servicio de push. Vacío = mailto:equipo@trademe.local
VAPID_SUBJECT=

# Secreto del webhook de alertas Reditum (TradingView). Vacío, el endpoint /tv-hook NO comprueba
# nada y acepta cualquier alerta: si lo expones a internet, defínelo. Ver docs/reditum-tradingview.md.
TV_WEBHOOK_SECRET=

# Acciones, divisas e índices (Twelve Data). Vacía = solo cripto vía Binance. Ver docs/proveedores.md.
TWELVEDATA_API_KEY=

# Asistente con modelo de lenguaje. Vacías = responde con su base local. Ver docs/asistente.md.
ASSISTANT_BASE_URL=
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
# Búsqueda en internet del asistente: tavily, brave o vacío (sin acceso a la red).
ASSISTANT_SEARCH=
ASSISTANT_SEARCH_KEY=

# Hosts extra que acepta la web, separados por comas, además de *.ts.net y localhost.
# Un valor que empieza por '.' autoriza el dominio y sus subdominios.
ALLOWED_HOSTS=
