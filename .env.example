# Modo solo-técnico: MACRO_ENABLED=false desactiva el sesgo macro en la decisión en vivo (por defecto false).
MACRO_ENABLED=false

# ─────────────────────────────────────────────────────────────
# TradeMe — variables de entorno (ejemplo, SIN valores reales)
# Copia a .env y rellena. Nunca subas .env al repo.
# ─────────────────────────────────────────────────────────────

# Cripto — Binance (los datos públicos NO requieren clave; M1 arranca sin clave)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Acciones — Alpaca (paper por defecto)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Forex — Twelve Data u OANDA
TWELVEDATA_API_KEY=
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=

# Webhook de TradingView (señales tipo SniperUltra)
TV_WEBHOOK_SECRET=
EXTERNAL_SIGNALS_CONFIG=apps/api/config/external_signals.yaml
# CORS: orígenes separados por comas; vacío = permitir cualquiera (dev)
CORS_ORIGIN=

# Módulo 3 · Auth del equipo (JWT). Vacío = API abierta (dev). En producción SIEMPRE debe estar
# puesto (genera el tuyo: openssl rand -base64 48). Los usuarios se crean con
# `pnpm --filter @trademe/api exec tsx scripts/create-user.ts <email> <password>` (sin registro público).
JWT_SECRET=

# Infraestructura
DATABASE_URL=postgres://trademe:trademe@localhost:5432/trademe
REDIS_URL=redis://localhost:6379

# apps/api
API_PORT=3001
API_HOST=0.0.0.0
LOG_LEVEL=info
TRADEME_SYMBOLS=BTCUSDT
TRADEME_INTERVALS=1m,5m,15m,30m,1h,4h,1d,1w

# apps/quant
MLFLOW_TRACKING_URI=file:./mlruns

# Seguridad / riesgo — la ejecución real SIEMPRE desactivada por defecto
ENABLE_LIVE_TRADING=false
# Capital para el sizing del plan de acción (M4)
ACCOUNT_EQUITY=10000

# M9 · Web Push (genera las tuyas en producción con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
PUSH_MIN_CONFIDENCE=0.65
PUSH_COOLDOWN_MS=600000

# Meta-modelo (Módulo 2). off = no usar · shadow = calcular sin afectar (recomendado al principio)
# · modulate = ajusta la confianza · veto = además descarta señales por debajo del umbral.
META_MODE=shadow
META_VETO_THRESHOLD=0.5
META_MODULATE_WEIGHT=0.5

# Captura automática de decisiones en el servidor (alimenta el dataset del meta-modelo sin
# depender de que alguien tenga el portal abierto).
AUTO_CAPTURE=true
AUTO_CAPTURE_MIN_CONFIDENCE=0.4
AUTO_CAPTURE_COOLDOWN_MIN=20
AUTO_CAPTURE_INTERVALS=15m,30m,1h,4h,1d

# --- Proveedores de datos de mercado ---
# Binance (cripto) va siempre y no necesita clave.
# Twelve Data añade acciones, divisas, índices y ETF. Clave gratuita en twelvedata.com.
# Vacío = proveedor desactivado; TradeMe sigue funcionando solo con cripto.
TWELVEDATA_API_KEY=

# --- Asistente con modelo de lenguaje (opcional) ---
# Vacío = base de conocimiento local, sin coste ni red. Cualquier servicio compatible con el
# formato de OpenAI sirve: Groq, Cerebras, Mistral, OpenRouter o un Ollama propio.
# Ver docs/asistente.md. Recomendado para empezar (gratis, sin tarjeta):
#   ASSISTANT_BASE_URL=https://api.groq.com/openai/v1
#   ASSISTANT_MODEL=llama-3.3-70b-versatile
ASSISTANT_BASE_URL=
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
